{
  "kind": "collectionType",
  "collectionName": "featured_photos",
  "info": {
    "singularName": "featured-photo",
    "pluralName": "featured-photos",
    "displayName": "Featured Photo",
    "description": "Featured photos for homepage display"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "priority": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "title": {
      "type": "string"
    },
    "source_photo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::photo.photo"
    }
  }
}
